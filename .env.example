# ─── SINIR Nacional ─────────────────────────────────────────────────────
# Token de integração SINIR — conta de transportadora (consulta apenas)
# Obtenha seu token em https://admin.sinir.gov.br
OPENMTR_SINIR_TOKEN=seu-integration-token-aqui

# ─── MTR Pernambuco ─────────────────────────────────────────────────────
# CNPJ da empresa (14 dígitos, apenas números)
MTR_PE_CNPJ=seu-cnpj-aqui
# CPF do usuário (11 dígitos, apenas números)
MTR_PE_CPF_USER=seu-cpf-aqui
# Senha do usuário
MTR_PE_PASSWORD=sua-senha-aqui
# Código da unidade
MTR_PE_UNITY=0000

# ─── Geral ──────────────────────────────────────────────────────────────
# Opcional: timeout em segundos para testes live (default: 60)
OPENMTR_TEST_TIMEOUT=60
