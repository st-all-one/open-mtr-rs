# ─── SINIR Nacional ─────────────────────────────────────────────────────
# Refresh token SINIR (tipo apiws-refresh, ~1 ano) — o adapter renova para
# obter o access token (apiws, ~8h) via POST /token. NÃO é o access token.
# Obtenha em https://admin.sinir.gov.br (Perfil > Integração via API).
SINIR_REFRESH_TOKEN=seu-refresh-token-aqui

# Habilita o teste live DESTRUTIVO de recebimento (consome 1 MTR real).
# Deixe desabilitado no dia a dia.
# OPENMTR_SINIR_LIVE_RECEIVE=0

# ─── MTR Pernambuco ─────────────────────────────────────────────────────
# CNPJ da empresa (14 dígitos, apenas números)
MTR_PE_CNPJ=seu-cnpj-aqui
# CPF do usuário (11 dígitos, apenas números)
MTR_PE_CPF_USER=seu-cpf-aqui
# Senha do usuário
MTR_PE_PASSWORD=sua-senha-aqui
# Código da unidade
MTR_PE_UNITY=0000

# ─── Geral ──────────────────────────────────────────────────────────────
# Opcional: timeout em segundos para testes live (default: 60)
OPENMTR_TEST_TIMEOUT=60
